# === Environnement ===
APP_ENV=dev                          # dev | prod
LOG_LEVEL=INFO
UVICORN_WORKERS=4                    # utilisé uniquement si APP_ENV=prod

# === Ports exposés sur l'hôte (changer si conflit local) ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5433
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_HTTP_PORT=6333
REDIS_HOST_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# === Postgres ===
POSTGRES_USER=sonar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sonar_echo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sonar:change_me@postgres:5432/sonar_echo

# === Neo4j ===
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_too
NEO4J_DATABASE=neo4j

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# === Redis / Arq ===
REDIS_URL=redis://redis:6379/0

# === MinIO (S3-compatible) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sonar
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=sonar-docs
MINIO_SECURE=false

# === JWT ===
JWT_SECRET_KEY=replace_with_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === LLM / OCR ===
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=gpt-4o
OPENAI_MODEL_ROUTING=gpt-4o-mini
OPENAI_MODEL_GENERATION=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# === SMTP (notifications email) ===
# Dev  : pointer sur le service mailhog du compose (UI sur http://localhost:8025)
# Prod : remplacer par un vrai SMTP (Sendgrid, SES, OVH, etc.)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sonar-echo@localhost
SMTP_TLS=false

# === Divers ===
RATE_LIMIT_PER_MINUTE=60
INGESTION_RATE_LIMIT_PER_MINUTE=10
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
